model ManagerReport {
  id                   Int            @id @default(autoincrement())
  branchId             Int            @map("branch_id")
  managerName          String         @map("manager_name")
  reportDate           DateTime       @map("report_date")
  managerComments      String         @map("manager_comments") @db.Text
  supplyPurchaseIssues String         @map("supply_purchase_issues") @db.Text
  briefingPoints       String         @map("briefing_points") @db.Text
  dailyLearnings       String         @map("daily_learnings") @db.Text
  createdByUserId      Int            @map("created_by_user_id")
  approvalStatus       ApprovalStatus @default(PENDING) @map("approval_status")
  approvedByUserId     Int?           @map("approved_by_user_id")
  approvedAt           DateTime?      @map("approved_at")
  approvalComment      String?        @map("approval_comment") @db.Text
  isDeleted            Boolean        @default(false) @map("is_deleted")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy User?  @relation("ApprovedManagerReports", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  complaints  GuestComplaint[]
  bpCpEntries BpCpEntry[]
  comments    ManagerReportComment[]

  @@unique([branchId, reportDate])
  @@index([reportDate])
  @@index([isDeleted])
  @@index([approvalStatus])
  @@map("manager_reports")
}

model GuestComplaint {
  id                 Int    @id @default(autoincrement())
  managerReportId    Int    @map("manager_report_id")
  guestName          String @map("guest_name")
  mobile             String
  email              String?
  complaintDetails   String @map("complaint_details") @db.Text
  serviceProviderName String @map("service_provider_name")
  responsiblePerson  String @map("responsible_person")
  actionTaken        String @map("action_taken") @db.Text
  solution           String @map("solution") @db.Text

  managerReport ManagerReport @relation(fields: [managerReportId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([managerReportId])
  @@map("guest_complaints")
}

model BpCpEntry {
  id              Int           @id @default(autoincrement())
  managerReportId Int           @map("manager_report_id")
  entryType       BpCpEntryType @map("entry_type")
  guestName       String        @map("guest_name")
  mobile          String
  comment         String?       @db.Text

  managerReport ManagerReport @relation(fields: [managerReportId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([managerReportId])
  @@map("bp_cp_entries")
}

model ManagerReportComment {
  id        Int      @id @default(autoincrement())
  reportId  Int      @map("report_id")
  userId    Int      @map("user_id")
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  report ManagerReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reportId])
  @@index([userId])
  @@map("manager_report_comments")
}
