DATABASE_URL="mysql://user:password@host:3306/dbname?ssl-mode=REQUIRED&connection_limit=1"
PORT=5000
# Comma-separated list of allowed frontend origins (drives CORS).
# Required when the frontend and backend are on SEPARATE domains — the guest form
# and public branch list are fetched straight from the browser, so every
# frontend origin must be listed here.
# Examples:
#   APP_URL=https://app.x-group.com
#   APP_URL=https://app.x-group.com,https://www.x-group.com
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=12
NODE_ENV=development
# Max rows fetched for report aggregation and Excel export (defaults: 1000 / 5000)
REPORT_FETCH_LIMIT=1000
REPORT_EXPORT_LIMIT=5000

# Rate limiting (defaults: 2000 req / 15 min globally, 50 logins / 15 min).
# Raise RATE_LIMIT_MAX if many users share one office (NAT) IP.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# Passwords for accounts created by `npm run seed` (super admin, admin, CEO, MD, managers).
# If a var is left unset, the seed generates a random password and prints it,
# except CEO/MD which fall back to their provisioned credentials.
# Set ALLOW_PRODUCTION_SEED=true to run the seed (WIPES ALL DATA) in production.
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CEO_PASSWORD=
# SEED_MD_PASSWORD=
# Optional approval signature image stamped on records the COO approves.
# SEED_COO_SIGNATURE=

# Scheduled booking report mails (Gmail SMTP, b7-style). Leave SMTP_USER empty
# to disable. Gmail needs an App Password, NOT the login password:
# Google Account → Security → 2-Step Verification → App passwords.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_SENDER=X-Group Reports <you@gmail.com>
# REPORT_MAIL_TO=amran.xgroup@gmail.com
